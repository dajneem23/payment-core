{
  "uid": "vietpay-wallet",
  "title": "VietPay — wallet-service (money core)",
  "tags": ["vietpay", "wallet-service"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP request rate by endpoint",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"wallet-service\"}[1m]))", "legendFormat": "{{uri}}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency by endpoint",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"wallet-service\"}[5m])))", "legendFormat": "{{uri}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "JVM heap used",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(jvm_memory_used_bytes{application=\"wallet-service\", area=\"heap\"})", "legendFormat": "heap used" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "HikariCP connections (active/idle)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_active{application=\"wallet-service\"}", "legendFormat": "active" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_idle{application=\"wallet-service\"}", "legendFormat": "idle" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "5xx rate (wallet edge)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(rate(traefik_service_requests_total{service=~\"wallet@.*\", code=~\"5..\"}[1m]))", "legendFormat": "5xx" } ]
    }
  ]
}
