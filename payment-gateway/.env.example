NODE_ENV=development

HOST=0.0.0.0
PORT=3005

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=vietpay
DB_PASSWORD=vietpay
DB_DATABASE=vietpay_payments

# Swagger
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=VietPay Payment Gateway
SWAGGER_DESCRIPTION=Topup payments via acquirer simulators with HMAC-signed settlement webhooks
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=http

# Kafka — publish payment events
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=payment-gateway
KAFKA_PAYMENT_TOPIC=payment-events

# Acquirer simulators
VISA_URL=http://visa-service:3006
MASTERCARD_URL=http://mastercard-service:3007
ACQUIRER_API_KEY=dev-acquirer-key
VISA_HMAC_SECRET=visa-dev-secret
MASTERCARD_HMAC_SECRET=mc-dev-secret
SELF_WEBHOOK_BASE_URL=http://payment-gateway:3005

# Outbox relay
OUTBOX_ENABLED=true
OUTBOX_POLL_MS=1000

# ── OpenTelemetry ─────────────────────────────────────────────────────────
# Service identity
OTEL_SERVICE_NAME=payment-gateway
OTEL_SERVICE_VERSION=1.0.0

# OTLP endpoint — traces sent here (Jaeger, Grafana Tempo, OTEL Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Set to DEBUG for verbose OTel diagnostics
# OTEL_LOG_LEVEL=DEBUG
