NODE_ENV=development

HOST=0.0.0.0
PORT=3004

# Swagger
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=VietPay User Service
SWAGGER_DESCRIPTION=Users & authentication (RFC 7519 JWT)
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=http

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=vietpay
DB_PASSWORD=vietpay
DB_DATABASE=vietpay_users

# JWT — ES256 (ECDSA P-256), asymmetric. The EC keypair is in keys/ (generated
# via openssl ecparam). Only user-service holds the private key; downstream
# services trust the X-User-Id header from Traefik ForwardAuth.
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ACCESS_EXPIRES_IN=900          # 15 min — short-lived
JWT_REFRESH_EXPIRES_IN=604800     # 7 days
JWT_ISSUER=vietpay-user-service
JWT_AUDIENCE=vietpay

# Redis — access-token blacklist (jti revocation on logout)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── OpenTelemetry ─────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=user-service
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_LOG_LEVEL=DEBUG
