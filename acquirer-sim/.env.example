NODE_ENV=development
PORT=3006
HOST=0.0.0.0

# Acquirer scheme (VISA | MASTERCARD)
SCHEME=VISA

# Comma-separated list of allowed BINs (leave empty to allow all)
ALLOWED_BINS=411111,424242,400000

# HMAC secret for signing outgoing webhooks
HMAC_SECRET=visa-dev-secret

# API key that callers must send in x-api-key header
ACQUIRER_API_KEY=dev-acquirer-key

# Delay before settlement webhook is fired (milliseconds)
SETTLEMENT_DELAY_MS=1500

# Probability of random decline (0.0 - 1.0, 0 = no random declines)
DECLINE_RATE=0

# ── OpenTelemetry ─────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=acquirer-sim
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Set to DEBUG for verbose OTel diagnostics
# OTEL_LOG_LEVEL=DEBUG
