NODE_ENV=production
HOST=0.0.0.0
PORT=3007

# Swagger
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=VietPay Mastercard Acquirer (simulated)
SWAGGER_DESCRIPTION=Simulated Mastercard acquirer — authorize/capture + settlement webhook
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=http

# Acquirer behaviour
SCHEME=MASTERCARD
# BIN allowlist — Mastercard ranges 51-55 / 2221-2720 (test BINs).
ALLOWED_BINS=510510,555555,520000,222100
# HMAC secret used to sign settlement webhooks — must match the gateway's MASTERCARD_HMAC_SECRET.
HMAC_SECRET=mc-dev-secret
# Shared key the gateway presents on authorize/capture (x-api-key).
ACQUIRER_API_KEY=dev-acquirer-key
# Async settlement delay + optional random decline rate (0..1).
SETTLEMENT_DELAY_MS=1500
DECLINE_RATE=0

# OpenTelemetry
OTEL_SERVICE_NAME=mastercard-service
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
