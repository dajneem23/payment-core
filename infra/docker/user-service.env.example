NODE_ENV=production
HOST=0.0.0.0
PORT=3004

# Swagger
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=VietPay User Service
SWAGGER_DESCRIPTION=Users & authentication (RFC 7519 JWT)
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=http

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=vietpay_users

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1

# JWT
JWT_PRIVATE_KEY_PATH=/app/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt-public.pem
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=vietpay-user-service
JWT_AUDIENCE=vietpay

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=user-service
KAFKA_USER_TOPIC=user-events

# OpenTelemetry
OTEL_SERVICE_NAME=user-service
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
