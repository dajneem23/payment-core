NODE_ENV=production
HOST=0.0.0.0
PORT=3002

# Swagger
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=VietPay FX Service
SWAGGER_DESCRIPTION=Exchange rates (bid/ask vs VND) from Vietcombank
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=http

# PostgreSQL (stores the latest fetched rates)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=vietpay_fx

# Redis (BullMQ queue backing the cron refresh)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2

# FX source + refresh schedule
FX_SOURCE_URL=https://portal.vietcombank.com.vn/Usercontrols/TVPortal.TyGia/pXML.aspx
FX_REFRESH_CRON=*/5 * * * *
FX_TIMEOUT_MS=5000

# OpenTelemetry
OTEL_SERVICE_NAME=fx-service
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
