NODE_ENV=production
HOST=0.0.0.0
PORT=3003

# Swagger
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=VietPay Notification Service
SWAGGER_DESCRIPTION=Email delivery via Nodemailer (SMTP)
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=http

# SMTP — fill in your credentials (e.g. Resend: smtp.resend.com, user=resend, pass=<api-key>)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxx
SMTP_FROM=VietPay <noreply@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com

# Kafka
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service
KAFKA_TRANSFER_TOPIC=transfer-events
KAFKA_USER_TOPIC=user-events

# OpenTelemetry
OTEL_SERVICE_NAME=notification-service
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
