NODE_ENV=production
HOST=0.0.0.0
PORT=3006

# Swagger
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=VietPay Visa Acquirer (simulated)
SWAGGER_DESCRIPTION=Simulated Visa acquirer — authorize/capture + settlement webhook
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=http

# Acquirer behaviour
SCHEME=VISA
# BIN allowlist — a card whose BIN is not listed is declined (402).
ALLOWED_BINS=411111,424242,400000
# HMAC secret used to sign settlement webhooks — must match the gateway's VISA_HMAC_SECRET.
HMAC_SECRET=visa-dev-secret
# Shared key the gateway presents on authorize/capture (x-api-key).
ACQUIRER_API_KEY=dev-acquirer-key
# Async settlement delay + optional random decline rate (0..1).
SETTLEMENT_DELAY_MS=1500
DECLINE_RATE=0

# OpenTelemetry
OTEL_SERVICE_NAME=visa-service
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
