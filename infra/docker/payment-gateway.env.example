NODE_ENV=production
HOST=0.0.0.0
PORT=3005

# Swagger
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=VietPay Payment Gateway
SWAGGER_DESCRIPTION=Card top-ups via simulated Visa/Mastercard acquirers
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=http

# PostgreSQL (owns payments, processed_webhooks, outbox_events)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=vietpay_payments

# Kafka (publishes PaymentCaptured via the outbox relay)
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=payment-gateway
KAFKA_PAYMENT_TOPIC=payment-events

# Acquirer simulators (east-west, by service name)
VISA_URL=http://visa-service:3006
MASTERCARD_URL=http://mastercard-service:3007
ACQUIRER_API_KEY=dev-acquirer-key
# Per-scheme HMAC secrets — must match each acquirer's HMAC_SECRET.
VISA_HMAC_SECRET=visa-dev-secret
MASTERCARD_HMAC_SECRET=mc-dev-secret
# Where acquirers post the async settlement webhook (direct to this container).
SELF_WEBHOOK_BASE_URL=http://payment-gateway:3005

# Outbox relay
OUTBOX_ENABLED=true
OUTBOX_POLL_MS=1000

# OpenTelemetry
OTEL_SERVICE_NAME=payment-gateway
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
