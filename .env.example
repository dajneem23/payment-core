# ── VietPay Docker Compose ─────────────────────────────────────────────────
#
# Each service has its own env file under infra/docker/. Copy the template
# and fill in your credentials:
#
#   cp infra/docker/user-service.env.example        infra/docker/user-service.env
#   cp infra/docker/notification-service.env.example infra/docker/notification-service.env
#
# Then edit each .env with real values and start the stack:
#
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up
#
# No root .env needed — docker-compose.yml uses env_file per service.
