NODE_ENV=development

HOST=0.0.0.0
PORT=3003

# Swagger
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=VietPay Notification Service
SWAGGER_DESCRIPTION=Email delivery via Nodemailer (SMTP)
SWAGGER_VERSION=1.0.0
SWAGGER_SCHEME=http

# SMTP — works with any provider (Gmail, Mailgun, SendGrid, Resend, etc.)
# Resend SMTP: host=smtp.resend.com, user=resend, pass=<your-api-key>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@vietpay.com
SMTP_PASS=
SMTP_FROM=VietPay <noreply@vietpay.com>
SUPPORT_EMAIL=support@vietpay.com

# Kafka — consume transfer / alert events
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service
KAFKA_TRANSFER_TOPIC=transfer-events
KAFKA_USER_TOPIC=user-events

# ── OpenTelemetry ─────────────────────────────────────────────────────────
# Service identity
OTEL_SERVICE_NAME=notification-service
OTEL_SERVICE_VERSION=1.0.0

# OTLP endpoint — traces sent here (Jaeger, Grafana Tempo, OTEL Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Set to DEBUG for verbose OTel diagnostics
# OTEL_LOG_LEVEL=DEBUG
